NODE_ENV=development
PORT=3000
# PostgreSQL connection. Use a real hosted database in staging/production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Comma-separated trusted browser origins
CORS_ORIGINS=http://localhost:5173
# Public HTTPS API URL used to build provider webhook callbacks
PUBLIC_API_URL=https://api.example.com
# JWT secrets must be at least 32 characters and unique per environment
JWT_ACCESS_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-unique-secret-of-at-least-32-characters
JWT_ISSUER=chama
JWT_AUDIENCE=chama-web
# Never commit real payment credentials
MERCADO_PAGO_ACCESS_TOKEN=replace-with-mercado-pago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=replace-with-webhook-secret-at-least-20-characters
