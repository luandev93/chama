generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  EXPIRATION
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  INVENTORY_CORRECTION
  RESERVATION
  RELEASE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT_EVENT
  STOCK_MOVEMENT
}

enum PricingMode {
  SECTION_DEFAULT
  CUSTOM_MARKUP
  DIRECT_SALE_PRICE
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  EXPIRED
}

enum OrderOrigin {
  POS
  WHATSAPP
  WEB
  MANUAL
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum LotTrackingPolicy {
  NONE
  OPTIONAL
  REQUIRED
}

enum ProductLotStatus {
  ACTIVE
  BLOCKED
  EXHAUSTED
  EXPIRED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model Tenant {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String             @unique
  plan         Plan               @default(FREE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stores       Store[]
  users        User[]
  categories   ProductCategory[]
  brands       Brand[]
  products     Product[]
  reservations StockReservation[]
  lots         ProductLot[]
  promotions   Promotion[]
  orders       Order[]
  auditLogs    AuditLog[]
}

model Store {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @db.Uuid
  name              String
  slug              String
  timezone          String                 @default("America/Recife")
  active            Boolean                @default(true)
  lotTrackingPolicy LotTrackingPolicy?
  minimumQty        Decimal?               @db.Decimal(14, 3)
  maximumQty        Decimal?               @db.Decimal(14, 3)
  reorderPoint      Decimal?               @db.Decimal(14, 3)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products          ProductStore[]
  balances          StockBalance[]
  movements         StockMovement[]
  reservations      StockReservation[]
  pricingPolicies   SectionPricingPolicy[]
  lots              ProductLot[]
  promotions        Promotion[]
  orders            Order[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  email        String
  passwordHash String
  displayName  String
  role         String
  status       UserStatus    @default(ACTIVE)
  mfaEnabled   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions     AuthSession[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId, status])
}

model AuthSession {
  id               String    @id
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ProductCategory {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  name              String
  slug              String
  active            Boolean            @default(true)
  lotTrackingPolicy LotTrackingPolicy?
  minimumQty        Decimal?           @db.Decimal(14, 3)
  maximumQty        Decimal?           @db.Decimal(14, 3)
  reorderPoint      Decimal?           @db.Decimal(14, 3)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sections          ProductSection[]
  products          Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, active, name])
}

model ProductSection {
  id                String                 @id @default(uuid()) @db.Uuid
  categoryId        String                 @db.Uuid
  name              String
  slug              String
  active            Boolean                @default(true)
  lotTrackingPolicy LotTrackingPolicy?
  minimumQty        Decimal?               @db.Decimal(14, 3)
  maximumQty        Decimal?               @db.Decimal(14, 3)
  reorderPoint      Decimal?               @db.Decimal(14, 3)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  category          ProductCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products          Product[]
  policies          SectionPricingPolicy[]

  @@unique([categoryId, slug])
  @@index([categoryId, active, name])
}

model SectionPricingPolicy {
  id            String         @id @default(uuid()) @db.Uuid
  storeId       String         @db.Uuid
  sectionId     String         @db.Uuid
  markupPercent Decimal        @default(0) @db.Decimal(7, 4)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  section       ProductSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([storeId, sectionId])
  @@index([storeId, active])
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  slug      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, active, name])
}

model Product {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  gtin              String?
  name              String
  category          String?
  categoryId        String?            @db.Uuid
  sectionId         String?            @db.Uuid
  brandId           String?            @db.Uuid
  unit              String
  active            Boolean            @default(true)
  lotTrackingPolicy LotTrackingPolicy?
  minimumQty        Decimal?           @db.Decimal(14, 3)
  maximumQty        Decimal?           @db.Decimal(14, 3)
  reorderPoint      Decimal?           @db.Decimal(14, 3)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  categoryRef       ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  section           ProductSection?    @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  stores            ProductStore[]
  movements         StockMovement[]
  balances          StockBalance[]
  reservations      StockReservation[]
  lots              ProductLot[]
  promotions        Promotion[]
  orderItems        OrderItem[]

  @@index([tenantId, name])
  @@index([tenantId, gtin])
  @@index([tenantId, categoryId, sectionId])
  @@index([tenantId, brandId])
}

model ProductStore {
  id                 String             @id @default(uuid()) @db.Uuid
  productId          String             @db.Uuid
  storeId            String             @db.Uuid
  costPrice          Decimal?           @db.Decimal(14, 4)
  salePrice          Decimal?           @db.Decimal(14, 4)
  pricingMode        PricingMode        @default(SECTION_DEFAULT)
  markupPercent      Decimal?           @db.Decimal(7, 4)
  grossMarginPercent Decimal?           @db.Decimal(7, 4)
  minimumQty         Decimal?           @db.Decimal(14, 3)
  maximumQty         Decimal?           @db.Decimal(14, 3)
  reorderPoint       Decimal?           @db.Decimal(14, 3)
  lotTrackingPolicy  LotTrackingPolicy?
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
}

model StockBalance {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  storeId          String   @db.Uuid
  productId        String   @db.Uuid
  physicalQuantity Decimal  @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([storeId, productId])
  @@index([tenantId, productId])
}

model StockReservation {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  storeId        String                @db.Uuid
  productId      String                @db.Uuid
  quantity       Decimal               @db.Decimal(14, 3)
  status         ReservationStatus     @default(ACTIVE)
  reference      String?
  expiresAt      DateTime?
  createdBy      String?               @db.Uuid
  releasedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store          Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotAllocations StockReservationLot[]

  @@index([tenantId, storeId, productId, status])
  @@index([expiresAt, status])
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  storeId        String      @db.Uuid
  status         OrderStatus @default(DRAFT)
  origin         OrderOrigin
  type           OrderType   @default(PICKUP)
  customerName   String?
  customerPhone  String?
  subtotal       Decimal     @default(0) @db.Decimal(14, 4)
  deliveryFee    Decimal     @default(0) @db.Decimal(14, 4)
  discountAmount Decimal     @default(0) @db.Decimal(14, 4)
  totalAmount    Decimal     @default(0) @db.Decimal(14, 4)
  notes          String?
  expiresAt      DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdBy      String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items          OrderItem[]

  @@index([tenantId, storeId, status, createdAt])
  @@index([tenantId, customerPhone, createdAt])
  @@index([expiresAt, status])
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  productId      String         @db.Uuid
  productName    String
  unit           String
  quantity       Decimal        @db.Decimal(14, 3)
  unitPrice      Decimal        @db.Decimal(14, 4)
  lineTotal      Decimal        @db.Decimal(14, 4)
  reservationId  String?        @db.Uuid
  lotAllocations OrderItemLot[]
  createdAt      DateTime       @default(now())
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  storeId        String            @db.Uuid
  productId      String            @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(14, 3)
  quantityBefore Decimal           @db.Decimal(14, 3)
  quantityAfter  Decimal           @db.Decimal(14, 3)
  reason         String?
  reference      String?
  actorUserId    String?           @db.Uuid
  lotId          String?           @db.Uuid
  createdAt      DateTime          @default(now())
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot            ProductLot?       @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, productId, createdAt])
  @@index([lotId])
}

model ProductLot {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  storeId          String                @db.Uuid
  productId        String                @db.Uuid
  code             String
  expiresAt        DateTime?
  quantity         Decimal               @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal               @default(0) @db.Decimal(14, 3)
  costPrice        Decimal?              @db.Decimal(14, 4)
  status           ProductLotStatus      @default(ACTIVE)
  receivedAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store            Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product          Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements        StockMovement[]
  reservations     StockReservationLot[]
  orderItems       OrderItemLot[]

  @@unique([storeId, productId, code])
  @@index([tenantId, storeId, productId, status, expiresAt])
}

model StockReservationLot {
  id            String           @id @default(uuid()) @db.Uuid
  reservationId String           @db.Uuid
  lotId         String           @db.Uuid
  quantity      Decimal          @db.Decimal(14, 3)
  createdAt     DateTime         @default(now())
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lot           ProductLot       @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([reservationId, lotId])
  @@index([lotId])
}

model OrderItemLot {
  id          String     @id @default(uuid()) @db.Uuid
  orderItemId String     @db.Uuid
  lotId       String     @db.Uuid
  quantity    Decimal    @db.Decimal(14, 3)
  createdAt   DateTime   @default(now())
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  lot         ProductLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, lotId])
}

model Promotion {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  storeId          String          @db.Uuid
  productId        String          @db.Uuid
  lotId            String?         @db.Uuid
  title            String
  status           PromotionStatus @default(ACTIVE)
  promotionalPrice Decimal?        @db.Decimal(14, 4)
  percentOff       Decimal?        @db.Decimal(7, 4)
  startsAt         DateTime
  endsAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, productId, status, startsAt, endsAt])
  @@index([lotId])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId, createdAt])
}
